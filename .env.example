# ==========================================
# Anti-Scraping Server Configuration
# ==========================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Security
SECURITY_STRICT_MODE=false

# Rate Limiting
THROTTLE_TTL=10
THROTTLE_LIMIT=20

# ==========================================
# PostgreSQL Configuration
# ==========================================

# Database Connection
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=p_user
DB_PASSWORD=p_pw
DB_NAME=p_db

# Connection Pool Settings
DB_MAX_CONNECTIONS=10
DB_MIN_CONNECTIONS=2
DB_ACQUIRE_TIMEOUT=60000
DB_IDLE_TIMEOUT=10000

# SSL Configuration (optional)
DB_SSL_ENABLED=false
DB_SSL_REJECT_UNAUTHORIZED=false

# Query Settings
DB_QUERY_TIMEOUT=30000
DB_STATEMENT_TIMEOUT=30000

# Logging
DB_LOGGING=false
DB_LOG_QUERIES=false

# ==========================================
# Redis Configuration
# ==========================================

# Basic Connection (from jdbc:redis://localhost:6379/0)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_FAMILY=4
REDIS_CONNECTION_NAME=anti-scraping-server

# Connection Settings
REDIS_CONNECT_TIMEOUT=10000
REDIS_KEEP_ALIVE=30000
REDIS_NO_DELAY=true

# Retry Strategy
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=1000

# Connection Pool
REDIS_POOL_MIN=2
REDIS_POOL_MAX=10

# Cache Settings
REDIS_DEFAULT_TTL=3600
REDIS_MAX_ITEMS=10000
REDIS_KEY_PREFIX=anti-scraping:

# Performance Optimization
REDIS_ENABLE_OFFLINE_QUEUE=true
REDIS_ENABLE_READY_CHECK=true
REDIS_LAZY_CONNECT=false
REDIS_AUTO_PIPELINING=false

# ==========================================
# Security Settings
# ==========================================

# Google reCAPTCHA v3 (optional)
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here
RECAPTCHA_SCORE_THRESHOLD=0.5
RECAPTCHA_FAIL_OPEN=false
RECAPTCHA_ALLOWED_HOSTNAMES=localhost,yourdomain.com

# IP Blocking
IP_BLACKLIST_TTL=86400
IP_BLACKLIST_MAX_MEMORY=10000

# User Agent Blocking (comma separated)
BLOCKED_USER_AGENTS=scrapy,python-requests,go-http-client,curl,wget,postman,insomnia,httpie,axios,node-fetch,got,undici,libwww-perl,mechanize,phantomjs,headlesschrome

# Honeypot Configuration
HONEYPOT_FIELD_NAME=email_confirm
HONEYPOT_TIME_THRESHOLD=2000

# Logging
LOG_LEVEL=debug
LOG_PRETTY=true
